{
    "name": "tokenized-position-keeping",
    "version": "0.1.0",
    "private": true,
    "description": "Prototype: permissioned tokenized securities, DvP settlement, a hybrid on-/off-chain position-keeping ledger with reconciliation, and an MCP wallet service for AI agents.",
    "license": "MIT",
    "scripts": {
        "compile": "hardhat compile",
        "test": "hardhat test",
        "chain": "hardhat node",
        "demo": "hardhat run scripts/demo.ts --network localhost",
        "mcp": "node --import tsx --disable-warning=ExperimentalWarning src/mcp/server.ts",
        "mcp:smoke": "node --import tsx --disable-warning=ExperimentalWarning scripts/mcp-smoke.ts",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@nomicfoundation/hardhat-toolbox": "^5.0.0",
        "@types/node": "^24.19.0",
        "hardhat": "^2.29.1",
        "ts-node": "^10.9.2",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.30.1",
        "@openzeppelin/contracts": "^5.6.1",
        "ethers": "^6.17.0",
        "zod": "^4.6.5"
    }
}